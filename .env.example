# === Data Sources ===
TRADIER_API_KEY=your_tradier_api_key_here
TRADIER_BASE_URL=https://api.tradier.com/v1
POLYGON_API_KEY=your_polygon_api_key_here
INTRINIO_API_KEY=your_intrinio_api_key_here

# === Database ===
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=volsurface
POSTGRES_USER=voluser
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://voluser:your_secure_password_here@localhost:5432/volsurface

# === Redis ===
REDIS_URL=redis://localhost:6379
REDIS_TTL_SECONDS=86400

# === Kafka ===
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=nvsf-consumer

# === AWS S3 ===
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=us-east-1
S3_BUCKET=vol-surface-system

# === MLflow ===
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=nvsf_v2_spx

# === API ===
API_KEY=your_api_key_here
API_HOST=0.0.0.0
API_PORT=8000

# === Model ===
MODEL_PATH=models/nvsf_production.pt
DEVICE=cuda
